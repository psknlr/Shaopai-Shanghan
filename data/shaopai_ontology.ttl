    rdfs:label "aliases"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( sp:Disease sp:Pattern sp:Formula sp:Herb ) ] ;
    rdfs:range xsd:string .

sp:channel a owl:DatatypeProperty ;
    rdfs:label "channel"@en ;
    rdfs:domain sp:Pattern ;
    rdfs:range xsd:string .

sp:triple_burner a owl:DatatypeProperty ;
    rdfs:label "triple_burner"@en ;
    rdfs:domain sp:Pattern ;
    rdfs:range xsd:string .

sp:nature a owl:DatatypeProperty ;
    rdfs:label "nature"@en ;
