    rdfs:domain sp:Work ;
    rdfs:range xsd:string .

sp:statement_zh a owl:DatatypeProperty ;
    rdfs:label "statement_zh"@en ;
    rdfs:domain sp:Doctrine ;
    rdfs:range xsd:string .

sp:topic a owl:DatatypeProperty ;
