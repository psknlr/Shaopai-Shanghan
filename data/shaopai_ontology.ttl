    rdfs:domain sp:CaseRecord ;
    rdfs:range xsd:string .

sp:kind a owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain sp:Institution ;
    rdfs:range xsd:string .

sp:place a owl:DatatypeProperty ;
    rdfs:label "place"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( sp:Institution sp:MedicalFamily ) ] ;
    rdfs:range xsd:string .

sp:founder a owl:DatatypeProperty ;
    rdfs:label "founder"@en ;
    rdfs:domain sp:Institution ;
    rdfs:range xsd:string .

sp:founded_year a owl:DatatypeProperty ;
    rdfs:label "founded_year"@en ;
    rdfs:domain sp:Institution ;
    rdfs:range xsd:string .

sp:modern_name a owl:DatatypeProperty ;
    rdfs:label "modern_name"@en ;
    rdfs:domain sp:Place ;
    rdfs:range xsd:string .

sp:specialty a owl:DatatypeProperty ;
    rdfs:label "specialty"@en ;
    rdfs:domain sp:MedicalFamily ;
    rdfs:range xsd:string .

sp:generations a owl:DatatypeProperty ;
    rdfs:label "generations"@en ;
    rdfs:domain sp:MedicalFamily ;
    rdfs:range xsd:string .

sp:modality rdfs:comment "受控值：舌诊 / 脉诊 / 腹诊 / 目诊 / 望诊 / 闻诊 / 问诊"@zh .

# ---------- Annotation properties (provenance, on rdf:Statement) ----------
sp:cardinality a owl:AnnotationProperty ; rdfs:label "cardinality"@en .

sp:sourceSentence a owl:AnnotationProperty ;
    rdfs:label "sourceSentence"@en, "原文"@zh ;
    rdfs:comment "verbatim source sentence backing the assertion"@en .

sp:chapterPath a owl:AnnotationProperty ;
    rdfs:label "chapterPath"@en, "章节路径"@zh ;
    rdfs:comment "chapter path of the source passage"@en .

sp:passageId a owl:AnnotationProperty ;
    rdfs:label "passageId"@en, "段落编号"@zh ;
    rdfs:comment "passage id in the segmented corpus"@en .

sp:evidenceVerbatim a owl:AnnotationProperty ;
    rdfs:label "evidenceVerbatim"@en, "证据逐字"@zh ;
    rdfs:comment "whether the evidence span is a verbatim substring of the passage"@en .

sp:engine a owl:AnnotationProperty ;
    rdfs:label "engine"@en, "抽取引擎"@zh ;
    rdfs:comment "extraction engine"@en .

sp:agreement a owl:AnnotationProperty ;
    rdfs:label "agreement"@en, "引擎一致性"@zh ;
    rdfs:comment "cross-engine agreement status"@en .

sp:nSupport a owl:AnnotationProperty ;
    rdfs:label "nSupport"@en, "支撑次数"@zh ;
    rdfs:comment "number of independent supporting passages"@en .

sp:layer a owl:AnnotationProperty ;
    rdfs:label "layer"@en, "抽取层"@zh ;
    rdfs:comment "extraction layer"@en .

sp:n_mentions a owl:AnnotationProperty ;
    rdfs:label "n_mentions"@en, "提及次数"@zh ;
    rdfs:comment "number of mentions of the entity in the corpora"@en .

sp:aliases a owl:AnnotationProperty ;
    rdfs:label "aliases"@en, "别名"@zh ;
    rdfs:comment "alias"@en .
