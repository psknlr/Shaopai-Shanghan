    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "曹氏详论不同暑病舌脉表现，治疗也各异，如疗伤暑，分以三焦；医中暑，颇重外感；治暑湿，当辨体质；愈伏暑，宜缓图之。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_0d67497eb2 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
