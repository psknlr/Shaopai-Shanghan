res:Doctrine_a1da188127 a sp:Doctrine ;
    rdfs:label "邪去正乃安，故逐邪以发表攻里为先。正足邪自去，故扶正以滋阴补阳为主。古人去病补虚，总不外发表、攻里、滋阴、补阳四大要法。"@zh ;
    sp:proposed_by "俞根初"@zh ;
