[] a rdf:Statement ;
    rdf:object res:Doctrine_0296fe9704 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 学术观点与诊治经验 / 见微知著，四诊尤重审舌"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01752"@zh ;
    sp:sourceSentence "西医重实迹，中医重气化。科学哲学，实事不同。唯辨舌苔，参西衷中，义理皆同，然西医不若中医之精且细也。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_02989987a7 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 原文选释 / 论伤寒食复"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01825"@zh ;
    sp:sourceSentence "余尝治温热瘥后房复，头重眼花，腰背痛，小腹里急绞痛，串胯筋挛，身热，心胸烦闷，便闭溲短，用鼠屎二钱、人中白三钱、晚蚕砂三钱、鲜生地五钱捣生锦纹一钱、蜣螂虫一钱、桃仁钱半、冬葵子三钱、川黄柏一钱、木通钱半、甘草梢八分，取其以浊导浊，效如桴鼓。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_03414112a2 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 学术观点与诊治经验 / 见微知著，四诊尤重审舌"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01752"@zh ;
    sp:sourceSentence "干黄为热，润白为寒，又如舌黑或肿，或焦而干涩，或卷缩坚硬，黑而芒刺，皆实热也。如黑而兼青，黑而濡滑，黑而柔软，皆寒证也。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_08aa9c9999 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
