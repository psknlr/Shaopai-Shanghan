[] a rdf:Statement ;
    rdf:object res:Doctrine_f8dbd10731 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_9b47f4ab2d ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 赵晴初 / 学术观点及诊治经验 / 治病先明医理，反对拘方制药"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "古人随证以立方，非立方以待病，熟察病情，详审用药，味味与病，针锋相对，无滥无遗，适至其所。如写真焉，肖其人而止，不可以意增减也。千变万化之中，具有一定不易之理，活泼圆机，有非语言文字所能解说，在学者心领神会而已。其所以设立方名者，规矩准绳，昭示来学，非谓某方一定治某病、某病一定用某方也。"@zh .

