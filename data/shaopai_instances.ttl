res:Doctrine_39511eab6b a sp:Doctrine ;
    rdfs:label "常人呼吸，每分钟约16至18次，若运动或进食，或精神兴奋时，则呼吸次数增加，这是生理现象。若发生病证，则会呈显著变化。减"@zh ;
    sp:statement_zh "常人呼吸，每分钟约16至18次，若运动或进食，或精神兴奋时，则呼吸次数增加，这是生理现象。若发生病证，则会呈显著变化。减少的一般属于虚弱或衰脱疾患，增加的，如胸膜病、肺炎喘息、心脏病、肾脏病、热性病等。"@zh ;
    sp:topic "望呼吸"@zh ;
    sp:n_mentions 1 .

res:Doctrine_3982b07efe a sp:Doctrine ;
    rdfs:label "其诊病，必先观目察舌，用两手按其胸脘至小腹，有无痛处，再问其口渴与否，大小便通与不通，服过何药，然后切脉辨症，查明其病源"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "其诊病，必先观目察舌，用两手按其胸脘至小腹，有无痛处，再问其口渴与否，大小便通与不通，服过何药，然后切脉辨症，查明其病源，审定其现象，心中了了，毫无疑似，方始处方"@zh ;
