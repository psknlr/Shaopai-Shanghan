    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00825"@zh ;
    sp:sourceSentence "“夫人禀阴阳五行之气以生，气有偏驳则病，药得阴阳五行之偏，是故以偏治偏，必归于平而后病愈。”"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_f02947482e ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_7577a19b15 ;
    sp:agreement "single_engine"@zh ;
