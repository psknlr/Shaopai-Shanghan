    sp:sourceSentence "章氏认为学医之方法，于诸家之说“要在读者因流溯源，知其理之所归”"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_b2102524a0 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_175513da37 ;
