res:Doctrine_7b6a64b5a3 a sp:Doctrine ;
    rdfs:label "虚里测吉凶、冲任辨真假寒热、察有形实积"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "虚里测吉凶、冲任辨真假寒热、察有形实积"@zh ;
