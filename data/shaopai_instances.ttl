res:Doctrine_031a6ad17b a sp:Doctrine ;
    rdfs:label "外感之证，不出风寒暑湿燥火六气，曰伤寒者，对杂病而言之；若对内伤而言，则伤寒亦同为外感。伤寒之方，多可施于六气，六气之病"@zh ;
    sp:proposed_by "周伯度"@zh ;
    sp:statement_zh "外感之证，不出风寒暑湿燥火六气，曰伤寒者，对杂病而言之；若对内伤而言，则伤寒亦同为外感。伤寒之方，多可施于六气，六气之病，亦可统于伤寒。是故欲明伤寒，当先详六气，六气者，伤寒之先河也"@zh ;
    sp:topic "伤寒与六气之关系"@zh ;
    sp:n_mentions 1 .

