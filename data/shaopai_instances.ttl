res:Doctrine_a6f9144d46 a sp:Doctrine ;
    rdfs:label "故古昔大医诊病决死生者，不视病之轻重，而视元气之存亡。元气不伤，虽病甚不死;元气或伤，虽病轻亦死。"@zh ;
