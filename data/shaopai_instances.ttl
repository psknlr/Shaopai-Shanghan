    sp:n_mentions 1 .

res:Doctrine_9a48e98ac3 a sp:Doctrine ;
    rdfs:label "止渴有不需参之证，生脉则惟参独擅。盖脉生于营，营属心。心体阴而用阳，惟冲和煦育之参，能补之"@zh ;
    sp:proposed_by "周伯度"@zh ;
