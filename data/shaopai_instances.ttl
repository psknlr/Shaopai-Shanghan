res:Formula_1bc9821205 a sp:Formula ;
    rdfs:label "柴陈煎"@zh ;
    sp:addHerbIf res:Herb_6a9994172a,
        res:Herb_9ad226e06d,
        res:Herb_d27bbdfdb7 ;
    sp:derivesFrom res:Work_1e67ecee5d ;
    sp:hasIngredient res:Herb_25a3db9c69,
        res:Herb_3a56fe56b8,
        res:Herb_c2d1278e89,
        res:Herb_c4d816fd56 ;
    sp:attributed_to "张景岳"@zh ;
    sp:preparation "水一盅半，煎七分，食远温服。如寒胜者，加细辛七、八分；如风胜气滞者，加苏叶一钱五分；如冬月寒甚者，加麻黄一钱五分；气逆多嗽者，加杏仁一钱；痞满气滞者，加白芥子五、七分。（《景岳全书·新方八阵散阵》）"@zh ;
    sp:source_work "景岳全书·新方八阵散阵"@zh ;
    sp:n_mentions 1 .

res:Formula_1ee1ffe5dc a sp:Formula ;
