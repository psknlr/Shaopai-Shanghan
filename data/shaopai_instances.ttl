[] a rdf:Statement ;
    rdf:object res:Herb_86b9e6031c ;
    rdf:predicate sp:ingredientRole ;
    rdf:subject res:Formula_2692e67aab ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 俞根初 / 四、方剂选录 / （七）五汁一枝煎"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:ingredientRoleValue "臣"@zh ;
    sp:nSupport 1 ;
    sp:passageId "b00723"@zh ;
    sp:sourceSentence "【秀按】心包邪热，开透肃清后，血液必枯，往往血虚生烦，愦愦无奈，心中不舒，间吐黏涎，呻吟错语。故以鲜地、茅根、藕汁三味，清润心包血液为君;臣以姜、沥二汁，辛润流利，以涤络痰；妙在佐紫苏旁枝，轻清宣络，以复其旁通四本之常。此为清润心包，濡血增液之良方。"@zh .

[] a rdf:Statement ;
    rdf:object res:Herb_064c9b2944 ;
    rdf:predicate sp:ingredientRole ;
    rdf:subject res:Formula_4c26d5471c ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 俞根初 / 四、方剂选录 / （一）苏羌达表汤"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:ingredientRoleValue "使"@zh ;
    sp:nSupport 1 ;
    sp:passageId "b00677"@zh ;
    sp:sourceSentence "【秀按】人有皮肉筋骨以成躯壳，皆谓之表。其中有脏腑以实之，则谓之里。而其能入里出表，全在经络，故谓之传经。方以苏叶为君，专为辛散经络之风寒而设。臣以羌活，辛散筋骨之风寒;防风、白芷，辛散肌肉之风寒。佐以杏、橘，轻苦微辛，引领筋骨肌肉之风寒，俾其从皮毛而出。使以姜、苓，辛淡发散为阳，深恐其发汗不彻，停水为患也。立法周到，故列为发汗之首剂。"@zh .

