res:Doctrine_953dc5f3b5 a sp:Doctrine ;
    rdfs:label "凡有余之病，由气之实；不足之病，因气之虚。如风寒、积滞、痰饮、瘀血之属，气不行则邪不除，此气之实也；虚劳、遗精、亡阳、失"@zh ;
    sp:proposed_by "张景岳"@zh ;
    sp:statement_zh "凡有余之病，由气之实；不足之病，因气之虚。如风寒、积滞、痰饮、瘀血之属，气不行则邪不除，此气之实也；虚劳、遗精、亡阳、失血之属，气不固则元不复，此气之虚也。"@zh ;
    sp:topic "气之虚实与病"@zh ;
    sp:n_mentions 1 .

