res:Doctrine_7096c2cea5 a sp:Doctrine ;
    rdfs:label "若有病之人，则不可不简，多病之人，尤不可以不简，只看其病之发于某家，单刀直入，直捣其巢。病在东而源在西，病在彼而源在此，"@zh ;
    sp:proposed_by "周声溢"@zh ;
    sp:statement_zh "若有病之人，则不可不简，多病之人，尤不可以不简，只看其病之发于某家，单刀直入，直捣其巢。病在东而源在西，病在彼而源在此， 删除枝叶，擒贼擒王，无枝枝节节而为之， 则乌得而不简乎?"@zh ;
    sp:topic "用药简"@zh ;
    sp:n_mentions 1 .

