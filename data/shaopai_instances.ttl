[] a rdf:Statement ;
    rdf:object res:Doctrine_7b82a05445 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_c884303f88 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 徐荣斋 / 学术观点及诊治经验 / 诊法重细节"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01924"@zh ;
    sp:sourceSentence "气短，呼吸短促而不相接续，与呼吸微弱不同而又相同。徐氏认为，气微的呼吸是静而无声的，气短是躁而带粗的；气微状态则自然，气短状态很勉强。并指出，气微者，在病机上只虚无实，多属外感病末传；气短者，在病机上有虚有实，多属内伤病初起。气微为病退之时，气短为病进之候。"@zh .

