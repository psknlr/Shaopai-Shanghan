res:Doctrine_b194f78ed6 a sp:Doctrine ;
    rdfs:label "邪动营血，必致皮肤痘疹四起，故用芍药（应以赤芍药为好）、葛根凉血透疹，柴胡、黄芩疏解少阳余热，连翘一味，既可助芍、葛透毒"@zh ;
    sp:proposed_by "景岳"@zh ;
    sp:statement_zh "邪动营血，必致皮肤痘疹四起，故用芍药（应以赤芍药为好）、葛根凉血透疹，柴胡、黄芩疏解少阳余热，连翘一味，既可助芍、葛透毒，又可帮柴、芩宣邪，生甘草调和诸药，又有解毒之能"@zh ;
    sp:topic "柴葛煎方义"@zh ;
    sp:n_mentions 1 .

