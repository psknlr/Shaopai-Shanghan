    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00433"@zh ;
    sp:sourceSentence "景岳用柴胡、黄芩清透少阳之邪，并以栀子、泽泻、木通导小肠火于尿液，利小便而实大便，泻痢自然而去，此少阳热痢柴芩煎确为精妥之剂"@zh .

