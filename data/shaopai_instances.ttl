    sp:nSupport 1 ;
    sp:passageId "p00911"@zh ;
    sp:sourceSentence "夫热邪在经，必从汗解，既无实积腹胀，其大便不解本无妨碍，何必通之，反使外邪内陷乎"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_34f3136a78 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_7577a19b15 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 学术观点及诊治经验 / 正气为本，邪正虚实乃辨病首务"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00847"@zh ;
    sp:sourceSentence "无虚者，急在邪气，去之不速，留则生变也；多虚者，急在正气，培之不早，临期不济也；微虚微实者，亦治其实，可一扫而除也；甚虚甚实者，所畏在虚，但固根本，以先为己之不可胜，则邪无不退也；二虚一实者，兼其实，开其一面也；二实一虚者，兼其虚，防生不测也。"@zh .

