res:Doctrine_29fad2cce8 a sp:Doctrine ;
    rdfs:label "吾国诊断学以切脉居其末，非谓脉大可凭，谓仅恃于脉而脉无凭，徒泥乎脉而脉更无凭；必也观形色，验舌辨苔，查病源，度病所，审病"@zh ;
    sp:proposed_by "何廉臣"@zh ;
    sp:statement_zh "吾国诊断学以切脉居其末，非谓脉大可凭，谓仅恃于脉而脉无凭，徒泥乎脉而脉更无凭；必也观形色，验舌辨苔，查病源，度病所，审病状，究病变，然后参之以脉，虽脉象无定，而活法在人，自不为脉所惑矣"@zh ;
    sp:topic "诊断学"@zh ;
    sp:n_mentions 1 .

res:Doctrine_29fd35b5f2 a sp:Doctrine ;
