res:Doctrine_01ae42f5af a sp:Doctrine ;
    rdfs:label "邪入少阳化热传及气分，故用石膏清阳明气分实热，热邪炽盛，必致阴液耗伤，麦冬养阴生津在所必用，少阳界面余热未尽，柴、芩疏达"@zh ;
    sp:proposed_by "景岳先生"@zh ;
    sp:statement_zh "邪入少阳化热传及气分，故用石膏清阳明气分实热，热邪炽盛，必致阴液耗伤，麦冬养阴生津在所必用，少阳界面余热未尽，柴、芩疏达邪气外散，并加竹叶若干引热从小便导下，二者一宣一引，均为给邪以出路"@zh ;
    sp:topic "柴胡白虎煎方义"@zh ;
    sp:n_mentions 1 .

