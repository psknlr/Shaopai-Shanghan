    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "太阳表寒虽解而阳明中有水气，此由胃阳素虚，猝为表寒所侵，触动里结之水气，累及脾胃不能健运所致。呕多者，先与吴茱萸汤止其呕，利多者，与胃苓汤，温中化水，继以香砂理中汤温健脾阳，升发胃气，其病即愈。"@zh .

