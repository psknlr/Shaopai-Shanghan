[] a rdf:Statement ;
    rdf:object res:TreatmentPrinciple_a2add053c0 ;
    rdf:predicate sp:treatedByPrinciple ;
    rdf:subject res:Pattern_c363464eef ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 俞根初 / 三、原文选释 / （四）六经用药法"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "b00615"@zh ;
    sp:sourceSentence "阳明宜下，轻则枳实、槟榔，重则大黄、芒硝;滑则桃、杏、五仁，润则当归、苁蓉。下水结则甘遂、大戟，下瘀结则醋炒生军，下寒结则巴豆霜，下热结则主生军。应用则用，别无他药可代。切勿以疲药塞责，药稳当而病反不稳当也。惟清宁丸最为缓下之通用。麻仁脾约丸，亦为滑肠之要药。"@zh .

[] a rdf:Statement ;
    rdf:object res:TreatmentPrinciple_76f378447d ;
    rdf:predicate sp:treatedByPrinciple ;
    rdf:subject res:Pattern_d2d2dc5e41 ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 俞根初 / 三、原文选释 / （四）六经用药法"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "b00617"@zh ;
    sp:sourceSentence "少阴宜补。滋阴，轻则归、芍、生地，重则阿胶、鸡黄，而石斛、麦冬尤生津液之良药。补阳，刚则附子、肉桂，柔则鹿胶、虎骨，而黄连、官桂尤交阴阳之良品。"@zh .

