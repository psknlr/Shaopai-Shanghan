res:Doctrine_0bbfbfb30f a sp:Doctrine ;
    rdfs:label "不但病因上局限于寒、暑二端，而且在季节上牵强于六气配属，限制了伏气学说的运用，也不能解释伏热外发的伏气症四时皆可发生的临"@zh ;
