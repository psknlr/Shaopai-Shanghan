[] a rdf:Statement ;
    rdf:object res:Doctrine_9fa0e1ca08 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_7577a19b15 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 生平与代表著作简介"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00825"@zh ;
    sp:sourceSentence "“无不以药性气味之阴阳，合乎人身表里阴阳虚实寒热者，是故投无不效，而七方十剂之法，亦尽具于中”"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_a2422cf616 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_7577a19b15 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 原文选释 / 治病之要，首当察人体质之阴阳强弱"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00869"@zh ;
    sp:sourceSentence "若更兼形瘦脉弱，食饮不多，此阴阳两弱之质。倘目有精彩，耳轮肉厚端正，其先天尚强，神清智朗者，反为大贵。若目无彩，神气昏庸，必多贫天。凡阴阳俱弱之质，常多病，却不甚重，亦不能受大补大泻大寒大热之药。但宜和平之味，缓缓调之，此大略也。"@zh .

