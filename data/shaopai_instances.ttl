[] a rdf:Statement ;
    rdf:object res:Doctrine_0a3dfcb072 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_b5cb5b9c75 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "俞根初临证经验集要 / 第二章 俞根初学术观点 / 第二节 “三化”传变观"@zh ;
    sp:corpus "ygc_jingyao"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "正阳阳明，有轻、重、危三证。轻者，热已结胃，胃腑不和也，法当泻热润燥，佐以和胃，调胃承气汤微下之。重者，胃中热结移入小肠，法当苦寒泻火，佐以辛通，小承气汤缓下之（微和胃气，勿令大泄下）。危者，胃小肠热结，上蒸心脑，下移大肠，急急峻下存阴为君，佐以息风开窍，大承气汤加犀角（二钱）、羚角（三钱）、紫雪（八分至一钱）急救之。"@zh .

