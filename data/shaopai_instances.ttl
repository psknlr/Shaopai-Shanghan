    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "而绵芪皮为疏达三焦外膜之主药，焦山栀为清宣三焦内膜之主药，制香附为疏达三焦气分之主药，全当归为辛润三焦络脉之主药。"@zh .

