[] a rdf:Statement ;
    rdf:object res:Herb_4fffdb45e8 ;
    rdf:predicate sp:hasIngredient ;
    rdf:subject res:Formula_8b3ab5e2ad ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 何廉臣 / 四、方剂选录 / （三）自订疏风止嗽汤"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "b01008"@zh ;
    sp:sourceSentence "与《医学心悟》之止嗽散（由桔梗、炙甘草、白前、橘红、百部、紫菀组成）相比，自订疏风止嗽汤增强了疏风解表之功，对于重伤风发热咳嗽者较止嗽散更适宜。"@zh .

