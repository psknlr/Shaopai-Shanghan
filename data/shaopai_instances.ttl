res:Doctrine_01ae42f5af a sp:Doctrine ;
    rdfs:label "邪入少阳化热传及气分，故用石膏清阳明气分实热，热邪炽盛，必致阴液耗伤，麦冬养阴生津在所必用，少阳界面余热未尽，柴、芩疏达"@zh ;
    sp:proposed_by "景岳先生"@zh ;
    sp:statement_zh "邪入少阳化热传及气分，故用石膏清阳明气分实热，热邪炽盛，必致阴液耗伤，麦冬养阴生津在所必用，少阳界面余热未尽，柴、芩疏达邪气外散，并加竹叶若干引热从小便导下，二者一宣一引，均为给邪以出路"@zh ;
    sp:topic "柴胡白虎煎方义"@zh ;
    sp:n_mentions 1 .

res:Doctrine_01cb126de0 a sp:Doctrine ;
    rdfs:label "用汉防己、焦茅术、川连、茯苓、泽泻祛其湿热，广木香、缩砂、陈皮利其气"@zh ;
    sp:proposed_by "张畹香"@zh ;
    sp:statement_zh "用汉防己、焦茅术、川连、茯苓、泽泻祛其湿热，广木香、缩砂、陈皮利其气"@zh ;
    sp:topic "利湿理气"@zh ;
    sp:n_mentions 1 .

res:Doctrine_0296fe9704 a sp:Doctrine ;
    rdfs:label "西医重实迹，中医重气化。科学哲学，实事不同。唯辨舌苔，参西衷中，义理皆同，然西医不若中医之精且细也。"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "西医重实迹，中医重气化。科学哲学，实事不同。唯辨舌苔，参西衷中，义理皆同，然西医不若中医之精且细也。"@zh ;
    sp:topic "舌诊为中西医汇通之桥梁"@zh ;
    sp:n_mentions 1 .

