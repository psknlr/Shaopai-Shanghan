res:Doctrine_0b442c5738 a sp:Doctrine ;
    rdfs:label "脑筋由心丛而来，其丛乃脊髓百结两根之所为。脑筋既根于心丛，自属心主知觉，脑髓听命于心。此可譬之电线，心发电，脊过电，而脑"@zh ;
    sp:statement_zh "脑筋由心丛而来，其丛乃脊髓百结两根之所为。脑筋既根于心丛，自属心主知觉，脑髓听命于心。此可譬之电线，心发电，脊过电，而脑其至所也。盖肾生精化髓而输于脑，心以阳而为。肾之使，理固如是"@zh ;
    sp:topic "脑筋与心主知觉"@zh ;
    sp:n_mentions 1 .

