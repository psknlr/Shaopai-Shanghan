    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "先生在清气泄热方后注释道：“方中寒水石清热泻火虽为主药，倘若见患者㾦疹隐隐，则当去寒水石之凉遏，改用桔梗、杏仁、银花之属，以利宣透肺气。”"@zh .

