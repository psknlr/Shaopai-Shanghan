[] a rdf:Statement ;
    rdf:object res:Work_f9e0a22b56 ;
    rdf:predicate sp:authored ;
    rdf:subject res:Physician_b5cb5b9c75 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 俞根初 / 学术观点及诊治经验 / 崇六经、参三焦，倡外感新论"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 2 ;
    sp:sourceSentence "“吾四十余年阅历以来，凡病之属阳明、少阳、厥阴而宜凉泻清滋者，十有七八；如太阳、太阴、少阴之宜温散温补者，十仅三四，表里双解，三焦并治，温凉合用，通补兼施者，最居多数”（《六经治法》）"@zh .

