res:Doctrine_6a32823395 a sp:Doctrine ;
    rdfs:label "活者，细察底里，隐隐犹见红活，此不过气血之有阻滞，非脏气之败坏也。死者，底里全变干晦枯萎，毫无生气，是脏气不至矣"@zh ;
    sp:proposed_by "徐荣斋"@zh ;
    sp:statement_zh "活者，细察底里，隐隐犹见红活，此不过气血之有阻滞，非脏气之败坏也。死者，底里全变干晦枯萎，毫无生气，是脏气不至矣"@zh ;
    sp:topic "舌质死活辨"@zh ;
    sp:n_mentions 1 .

res:Doctrine_6a40bee365 a sp:Doctrine ;
    rdfs:label "阴虚阳盛者，其苔必干;阳虚阴盛者，其舌必滑。阴虚阳盛而火旺者，其舌必干而燥；阳虚阴盛而火衰者，其舌必滑而湿。"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "阴虚阳盛者，其苔必干;阳虚阴盛者，其舌必滑。阴虚阳盛而火旺者，其舌必干而燥；阳虚阴盛而火衰者，其舌必滑而湿。"@zh ;
    sp:topic "以干润舌苔分阴阳"@zh ;
    sp:n_mentions 1 .

