    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "人皆谓百病莫难于伤寒，予谓治伤寒何难？治伤寒兼证稍难，治伤寒夹证较难，治伤寒变证更难，治伤寒坏证最难"@zh .

