res:Doctrine_9413e30a4f a sp:Doctrine ;
    rdfs:label "虚者由脑缺血，以补中益气汤加鹿茸血片，提血上行以补脑；实者由脑积血，以调胃承气汤冲犀角汁，泻血下行以清脑"@zh ;
    sp:proposed_by "程祖植"@zh ;
    sp:statement_zh "虚者由脑缺血，以补中益气汤加鹿茸血片，提血上行以补脑；实者由脑积血，以调胃承气汤冲犀角汁，泻血下行以清脑"@zh ;
    sp:topic "中风虚实分治"@zh ;
    sp:n_mentions 1 .

