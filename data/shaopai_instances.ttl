    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01762"@zh ;
    sp:sourceSentence "如霍乱四肢厥冷者，用吴茱萸一两研细末，和盐卤调涂两手足心，以导引内热达四肢。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_10779b5c1d ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 学术观点与诊治经验 / 用药轻灵，论治常顾暑湿"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01765"@zh ;
    sp:sourceSentence "治法以蚕沙、滑石、蒌皮、郁金化滞宣气开郁，鲜生地捣豆豉、青蒿、白薇、焦栀以清透营热从外达。湿化热透，大便自下，小溲亦长。若误用羌、防、枳、朴则化燥，反加胸闷干呕。若用硝、黄妄下，则下利稀水，口舌化燥，胸闷干呕，热亦增剧，脾胃浊垢，因化燥而不下"@zh .

