res:Doctrine_5dc2644924 a sp:Doctrine ;
    rdfs:label "太阳伤寒，其邪有但传少阳阳明而止者；有不传少阳阳明越传三阴者，各随其人之体质阴阳，脏腑寒热。从火化者为热证，从水化者为寒"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "太阳伤寒，其邪有但传少阳阳明而止者；有不传少阳阳明越传三阴者，各随其人之体质阴阳，脏腑寒热。从火化者为热证，从水化者为寒证，从水火合化者，则为寒热错杂之证"@zh ;
    sp:topic "伤寒传变机理"@zh ;
    sp:n_mentions 1 .

