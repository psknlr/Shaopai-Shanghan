[] a rdf:Statement ;
    rdf:object res:Work_54d3dac20b ;
    rdf:predicate sp:statedIn ;
    rdf:subject res:Doctrine_6739ec9521 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 赵晴初 / 原文选释 / 阴阳升降盈虚消长论"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim false ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "人身内外作两层，上下作两截，而内外上下，每如呼吸而动相牵引。譬如攻下而利，是泄其在内之下截，而上截之气即陷，内上既空，而外层之表气连邪内人，此结胸之根也。譬如发表而汗，是疏其在外之上截，而在内之气跟出，内上既空，其内下之阴气上塞，此痞闷之根也。识此，在上禁过汗，在内慎攻下之法，后读仲圣《伤寒论》结胸及痞塞诸证，则冰消雪化矣，此高学山先生《伤寒尚论篇》辨似中语。"@zh .

