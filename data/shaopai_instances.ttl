[] a rdf:Statement ;
    rdf:object res:Herb_0e8cf2a23f ;
    rdf:predicate sp:hasIngredient ;
    rdf:subject res:Formula_e7d3222d7e ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 何廉臣 / 四、方剂选录 / （五）达郁宽中汤"@zh ;
    sp:dose "五分"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "b01016"@zh ;
    sp:sourceSentence "多因于气情郁结，气道壅隔，上不得降，下不得升，胸腹胀满，四肢瘦削，《内经》所谓“浊气在上，则生●胀”是也。治宜升清降浊，达郁宽中汤（沉香片五分，莱砂散一钱，生鸡内金三钱，白芍五钱，归须、真川朴、陈香橼皮各一钱，川柴胡五分，用晚蚕砂五钱，鲜茅根二两，葱须五分，煎汤代水）。（《三订通俗伤寒论》第九章 伤寒夹证 第九节 夹胀伤寒）"@zh .

