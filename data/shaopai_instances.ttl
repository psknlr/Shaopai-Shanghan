res:Doctrine_0313431ca8 a sp:Doctrine ;
    rdfs:label "论伤寒之汗法、下法、补法、慎用苦寒的学术观点"@zh ;
    sp:proposed_by "张景岳"@zh ;
    sp:statement_zh "论伤寒之汗法、下法、补法、慎用苦寒的学术观点"@zh ;
    sp:topic "伤寒治法"@zh ;
    sp:n_mentions 1 .

res:Doctrine_031a6ad17b a sp:Doctrine ;
    rdfs:label "外感之证，不出风寒暑湿燥火六气，曰伤寒者，对杂病而言之；若对内伤而言，则伤寒亦同为外感。伤寒之方，多可施于六气，六气之病"@zh ;
    sp:proposed_by "周伯度"@zh ;
    sp:statement_zh "外感之证，不出风寒暑湿燥火六气，曰伤寒者，对杂病而言之；若对内伤而言，则伤寒亦同为外感。伤寒之方，多可施于六气，六气之病，亦可统于伤寒。是故欲明伤寒，当先详六气，六气者，伤寒之先河也"@zh ;
    sp:topic "伤寒与六气之关系"@zh ;
    sp:n_mentions 1 .

res:Doctrine_0330e857d2 a sp:Doctrine ;
    rdfs:label "极重用抵当汤去虻虫（光桃仁二十颗、酒醋炒生川军二钱、盐炒水蛭三支研细）加夜明砂（三钱包煎）、蜜炙延胡（钱半）、炒穿甲（一"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "极重用抵当汤去虻虫（光桃仁二十颗、酒醋炒生川军二钱、盐炒水蛭三支研细）加夜明砂（三钱包煎）、蜜炙延胡（钱半）、炒穿甲（一钱）、杜牛膝（四钱）、麝香（五厘冲）等峻攻之"@zh ;
    sp:topic "蓄血极重证治法"@zh ;
    sp:n_mentions 1 .

res:Doctrine_03414112a2 a sp:Doctrine ;
    rdfs:label "干黄为热，润白为寒，又如舌黑或肿，或焦而干涩，或卷缩坚硬，黑而芒刺，皆实热也。如黑而兼青，黑而濡滑，黑而柔软，皆寒证也。"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "干黄为热，润白为寒，又如舌黑或肿，或焦而干涩，或卷缩坚硬，黑而芒刺，皆实热也。如黑而兼青，黑而濡滑，黑而柔软，皆寒证也。"@zh ;
    sp:topic "以苔色明暗识寒热"@zh ;
    sp:n_mentions 1 .

res:Doctrine_034548c3dd a sp:Doctrine ;
    rdfs:label "右关沉迟濡缓，当胃而痛者，是两关脉不弦，断非肝气犯胃，寒入为多，不必用厥阴之药，此乃胃气痛也"@zh ;
    sp:statement_zh "右关沉迟濡缓，当胃而痛者，是两关脉不弦，断非肝气犯胃，寒入为多，不必用厥阴之药，此乃胃气痛也"@zh ;
