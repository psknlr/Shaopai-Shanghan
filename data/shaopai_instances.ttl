    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "真者有质，刮之底色不去。假者无形，一刮底色全无。如白苔黄边舌，刮之见淡红润泽之底，为微邪也。"@zh .

