[] a rdf:Statement ;
    rdf:object res:Herb_1a171663ae ;
    rdf:predicate sp:ingredientRole ;
    rdf:subject res:Formula_d67db4a3e4 ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 俞根初 / 四、方剂选录 / （十）阿胶鸡子黄汤"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:ingredientRoleValue "臣"@zh ;
    sp:nSupport 1 ;
    sp:passageId "b00744"@zh ;
    sp:sourceSentence "【秀按】血虚生风者，非真有风也。实因血不养筋，筋脉拘挛，伸缩不能自如，故手足瘛疭，类似风动，故名曰内虚暗风，通称肝风。温热病末路多见此症者，以热伤血液故也。方以阿胶、鸡子黄为君，取其血肉有情，液多质重，以滋血液而息肝风。臣以芍、草、茯神木，一则酸甘化阴以柔肝，一则以木制木而息风。然心血虚者，肝阳必亢，故佐以决明、牡蛎介类潜阳。筋挛者络亦不舒，故使以钩藤、络石通络舒筋也。此为养血滋阴，柔肝息风之良方。"@zh .

