    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p02097"@zh ;
    sp:sourceSentence "曹氏详论不同暑病舌脉表现，治疗也各异，如疗伤暑，分以三焦；医中暑，颇重外感；治暑湿，当辨体质；愈伏暑，宜缓图之。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_0d67497eb2 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 学术观点与诊治经验 / 见微知著，四诊尤重审舌"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01752"@zh ;
    sp:sourceSentence "顺则可治，逆则难医，如夏月人病黑苔，是时气与邪火，内外炎烁，尚有可生。如冬月黑苔厚刺，正不胜邪，必难救治也。"@zh .

[] a rdf:Statement ;
