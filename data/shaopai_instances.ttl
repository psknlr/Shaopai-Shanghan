    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00869"@zh ;
    sp:sourceSentence "若更兼体丰肌厚，脉盛皮粗，食啖倍多，此阴阳俱盛之质。平时少病，每病多重，以邪蓄深久故也。须用重药，如大黄、芒硝、干姜、桂、附之类。"@zh .

[] a rdf:Statement ;
