    sp:nSupport 1 ;
    sp:sourceSentence "邵氏认为妇科疾病多与冲任二脉相关，治疗时以调理任带冲脉为主，同时重视肝、肾、胃等脏腑的辨治。"@zh .

[] a rdf:Statement ;
