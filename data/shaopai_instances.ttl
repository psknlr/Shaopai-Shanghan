res:Doctrine_98029eb469 a sp:Doctrine ;
    rdfs:label "当按四时法治之。在冬令发瘩，当用冬温法；夏时用暑风法；秋时用秋燥法；春时用风温法"@zh ;
    sp:proposed_by "张畹香"@zh ;
    sp:statement_zh "当按四时法治之。在冬令发瘩，当用冬温法；夏时用暑风法；秋时用秋燥法；春时用风温法"@zh ;
