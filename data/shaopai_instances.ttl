res:Doctrine_9b45ece6f2 a sp:Doctrine ;
    rdfs:label "阳明宜下，轻则枳实、槟榔，重则大黄、芒硝，滑则桃、杏、五仁，润则当归、苁蓉。"@zh ;
    sp:proposed_by "俞氏"@zh ;
