res:Doctrine_934a9a9e1e a sp:Doctrine ;
    rdfs:label "天不足西北，故西北方阴也，而人右耳目不如左明也；地不满东南，故东南方阳也，而人左手足不如右强也"@zh ;
    sp:proposed_by "素问·阴阳应象大论"@zh ;
