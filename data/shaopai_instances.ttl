[] a rdf:Statement ;
    rdf:object res:Herb_30c5dc345d ;
    rdf:predicate sp:hasIngredient ;
    rdf:subject res:Formula_ca0ff9bdb7 ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 曹炳章 / 三、原文选释 / （七）论伤寒食复"@zh ;
    sp:dose "三分"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "b01738"@zh ;
    sp:sourceSentence "王士雄云：阴阳二易，余谓之热入血室症。第阴易较重于阳易，以女人病热之气，本从阴户出也。古人用烧裩之义最精，取其能引热邪，仍由原路去，故阴易须剪所交接女人未浣裩裆。《千金》用月经赤帛，亦从此脱胎。《活人书》治房劳头重眼花，小腹绞痛，用豭鼠粪汤(鼠粪两头尖者十四粒、韭白根一握，水二钟煎)，不可热服，随症加减，有黏汗为效。或调烧裩散，同服。女劳复，头重目花，腹中绞痛有热者，用刮青竹皮半升，煎服，随症加减，调烧裩散、赤衣散（治女劳复，并阴易，以室女月经布近阴处，剪一方，烧灰，调药服下）。虚弱脉微者，以四君子汤，送烧裩散;或人参三白汤，调赤衣散服之。小腹里急，脉沉逆冷，当归四逆汤加附子、吴萸，送赤衣散，"@zh .

