[] a rdf:Statement ;
    rdf:object res:Doctrine_103171a41e ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_64d2cbdcf5 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 何廉臣 / 学术观点及诊治经验 / 巧施治，完善温病治法方药"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00997"@zh ;
    sp:sourceSentence "但必须辨其为毒火宜急下，如紫草承气汤等；风火宜疏下，如局方凉膈散等；燥火宜润下，如千金生地黄汤、《温疫论》养荣承气汤等；痰火宜降下，如承气陷胸汤等；食积化火宜清下，如枳实导滞汤等；瘀血化火宜通下，如桃仁承气汤、下瘀血汤等；水火互结宜导下，如大陷胸汤、控涎丹等；若气虚失下者，宜润下兼补气，如《金匮翼》黄芪汤等；血虚失下者，宜润下兼益血，如《金鉴》玉烛散等；气血两亏而又不得不下者，宜陶氏黄龙汤等等"@zh .

