    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00840"@zh ;
    sp:sourceSentence "根据他的主张，秋当主燥，但立秋后，湿土司令尚有一月，因此，如按节气与六气相配则似不符，但如按阴阳进退之理，以审气候，则若合符节。"@zh .

