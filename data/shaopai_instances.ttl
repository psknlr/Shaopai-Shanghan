res:Doctrine_808d019dbf a sp:Doctrine ;
    rdfs:label "今俞氏以柴、芩为君者，以柴胡疏达膜原之气机，黄芩苦泄膜原之郁火也；臣以枳、桔开上，朴、果疏中，青、槟达下，以开达三焦之气"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "今俞氏以柴、芩为君者，以柴胡疏达膜原之气机，黄芩苦泄膜原之郁火也；臣以枳、桔开上，朴、果疏中，青、槟达下，以开达三焦之气机，使膜原伏邪，从三焦而外达肌腠也;佐以荷梗透之，使以甘草和之。"@zh ;
    sp:topic "柴胡达原饮方义"@zh ;
    sp:n_mentions 1 .

