[] a rdf:Statement ;
    rdf:object res:Doctrine_ef5923c7fb ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_5f1fdad40e ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 原文选释 / 论临经伤寒"@zh ;
