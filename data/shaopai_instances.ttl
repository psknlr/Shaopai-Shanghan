    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00817"@zh ;
    sp:sourceSentence "业医者，不肯究心圣经理法，陋习相沿，不识阴阳虚实，通套一方，混治诸病，而谓道止如是，名为仁术，不知杀人于冥冥中"@zh .

