[] a rdf:Statement ;
    rdf:object res:Herb_9c2c2c6d0c ;
    rdf:predicate sp:hasIngredient ;
    rdf:subject res:Formula_763609d322 ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 胡宝书 / 二、学术观点及诊治经验 / （六）治痢特色"@zh ;
    sp:dose "三钱"@zh ;
    sp:doseNote "黄连"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "b01485"@zh ;
    sp:sourceSentence "茹左，下利咽痛，口渴心烦，尺脉数疾。此热邪内耗少阴之阴，宜猪肤汤加减。猪肤四两煎汤取清汁，白蜜冲二匙、知母、生地各三钱，黄连、生草各一钱半。方中知母、生地清热养阴而不腻，黄连清热燥湿，猪肤汁、白蜜以监黄连苦燥之性，生草调和诸药，使之补而不碍邪，攻而不伤正。"@zh .

