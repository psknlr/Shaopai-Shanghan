    sp:source_work "景岳全书·新方八阵散阵"@zh ;
    sp:n_mentions 1 .

res:Formula_6cb4719c37 a sp:Formula ;
    rdfs:label "大温中饮"@zh ;
    sp:addHerbIf res:Herb_381ac8de06 ;
    sp:derivesFrom res:Work_1e67ecee5d ;
    sp:hasIngredient res:Herb_2d9de9e26e,
        res:Herb_4fffdb45e8,
        res:Herb_50b949134d,
        res:Herb_9ad226e06d,
        res:Herb_c9bcf97acb ;
    sp:removeHerbIf res:Herb_25a3db9c69,
        res:Herb_2d9de9e26e ;
    sp:attributed_to "张景岳"@zh ;
    sp:preparation "水二盅，煎七分，去浮沫，温服，或略盖取微汗。如气虛，加黄芪二、三钱；如寒甚阳虚者，加制附子一、二钱;头痛，加川芎或白芷、细辛；阳虚气陷，加升麻；如肚腹泄泻，宜少减柴胡，加防风、细辛亦可。尝见伤寒之治，惟仲景能知温散，如麻黄、桂枝等汤是也；亦知补气而散，如小柴胡之属是也。至若阳根于阴，汗化于液，从补血而散，而云腾致雨之妙，则仲景犹所未及，故予制此方，乃邪从营解第一义也，其功难悉，所当深察。（《景岳全"@zh ;
    sp:source_work "景岳全书·新方八阵散阵"@zh ;
    sp:n_mentions 1 .

