    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "虚者，虚其心，则神自清；无者，无其欲，则精自固。天真之气，从之生长，而精神固守于内，何病之有？"@zh .

