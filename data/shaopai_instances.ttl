    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00849"@zh ;
    sp:sourceSentence "章氏认为先天禀赋的差异、地理环境的不同、饮食习惯的区别是形成体质差异化的主要原因"@zh .

[] a rdf:Statement ;
