res:Formula_7902bf2e74 a sp:Formula ;
    rdfs:label "正柴胡饮"@zh ;
    sp:addHerbIf res:Herb_0ac6708250 ;
    sp:derivesFrom res:Work_1e67ecee5d ;
    sp:hasIngredient res:Herb_25a3db9c69,
        res:Herb_2d9de9e26e,
