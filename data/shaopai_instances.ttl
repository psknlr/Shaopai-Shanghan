res:Doctrine_31d3d68aa3 a sp:Doctrine ;
    rdfs:label "故俞氏治吐泻不得、腹痛昏闷、病势险急之干霍乱，急用涌吐法，川椒五七粒和食盐拌炒微黄，开水泡汤，调入飞马金丹十四五粒，作速"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "故俞氏治吐泻不得、腹痛昏闷、病势险急之干霍乱，急用涌吐法，川椒五七粒和食盐拌炒微黄，开水泡汤，调入飞马金丹十四五粒，作速灌肠，使其上吐下泻，祛其邪以安正"@zh ;
    sp:topic "干霍乱救治"@zh ;
    sp:n_mentions 1 .

res:Doctrine_321b38c0a8 a sp:Doctrine ;
    rdfs:label "外寒宜汗，宜用太阳汗剂药；里寒宜温，宜用太阴温剂药，固已，惟上焦可佐生姜、蔻仁；中焦可佐以朴、草果，或佐丁香、花椒；下焦"@zh ;
    sp:proposed_by "俞根初"@zh ;
