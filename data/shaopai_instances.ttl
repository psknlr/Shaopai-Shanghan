    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "其中明确提到：“本门最详者脉也，脉为气血流行之象，而有升降出入，故当与营卫经络、阴阳脏腑诸门同观。必得悟其神理，指下方能明其为和、为病、为虚、为实。”"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_9240701044 ;
    rdf:predicate sp:proposes ;
