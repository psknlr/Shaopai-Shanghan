    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01739"@zh ;
    sp:sourceSentence "从假托乱真之去伪、名物传讹之考正、仿造伪品之革除、埋没良材之推行、不精修治之改良、采取贮藏之合法六个部分论述药品改良之方法。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_47be302d93 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 学术观点与诊治经验 / 见微知著，四诊尤重审舌"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01752"@zh ;
    sp:sourceSentence "病属虚者，其舌必浮胖而娇嫩。实热之证，全舌必有黄黑积滞干焦罅裂芒刺等苔。阴虚之证，全舌必绛色无苔，虽有横直罅纹，而舌则短小不等。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_4e9b2114f1 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 医案选按"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01869"@zh ;
    sp:sourceSentence "余主先镇纳肝阳，滋液生津，兼清邪热熄风。佐以芩连坚阴，庶几龙雷之火，仍潜伏命门。而脾胃膀胱复能腐化蒸腾，则泄泻能止。上逆之火下潜，心脑顿失蒙蔽，则神识亦能清明。"@zh .

