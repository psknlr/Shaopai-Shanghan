res:Doctrine_3f166c2422 a sp:Doctrine ;
    rdfs:label "清热破血一方，重用桃仁、赤芍、延胡行血散瘀，配郁金、紫草凉血热而解郁结，加焦山栀、路路通以通达三焦而走脉络，对热入血室与"@zh ;
