    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "又如他驳斥前人关于“秋之前半截伤湿，后半截伤燥”的说法为臆说，也是从阴阳进退消长之理来分析的。"@zh .

[] a rdf:Statement ;
