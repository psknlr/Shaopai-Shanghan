[] a rdf:Statement ;
    rdf:object res:Herb_4f166e82a9 ;
    rdf:predicate sp:ingredientRole ;
    rdf:subject res:Formula_0004ef1e1f ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 俞根初 / 四、方剂选录 / （六）神术汤"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:ingredientRoleValue "臣"@zh ;
    sp:nSupport 1 ;
    sp:passageId "b00715"@zh ;
    sp:sourceSentence "【秀按】素禀湿滞，恣食生冷油腻，成湿霍乱者甚多。陡然吐泻腹痛，胸膈痞满。故君以藿、朴、橘、术温理中焦，臣以查、曲消滞，佐以砂仁运气，使以甘草，缓其燥烈之性。此为温中导滞，平胃快脾之良方。"@zh .

