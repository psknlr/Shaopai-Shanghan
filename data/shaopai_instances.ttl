res:Doctrine_8ed179ca7f a sp:Doctrine ;
    rdfs:label "结邪为病，所关甚大，病之为痞为满，为喘为肿，为闷为闭，为痛为胀，直无一不涉于结……故里病总以解结为治，结一解而病无不去"@zh ;
    sp:proposed_by "何廉臣"@zh ;
    sp:statement_zh "结邪为病，所关甚大，病之为痞为满，为喘为肿，为闷为闭，为痛为胀，直无一不涉于结……故里病总以解结为治，结一解而病无不去"@zh ;
    sp:topic "攻里法·解结为治"@zh ;
    sp:n_mentions 1 .

