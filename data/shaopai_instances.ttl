res:Formula_64873f0d4d a sp:Formula ;
    rdfs:label "热霍乱初起方"@zh ;
    sp:derivesFrom res:Work_0ac5470981 ;
    sp:formulaTreats res:Pattern_7c91d754e6 ;
    sp:hasIngredient res:Herb_0f52e717ed,
        res:Herb_35f93d786b,
        res:Herb_46501bb97b,
        res:Herb_94d31dd8bb,
        res:Herb_a01b656571,
        res:Herb_c129c71b24,
        res:Herb_e1ec0f4163,
        res:Herb_e7f87d7311,
        res:Herb_ff1fa16b63 ;
    sp:attributed_to "曹炳章"@zh ;
    sp:indication "治热霍乱舌灰腻，或黄燥，或边尖红，中薄白。呕吐酸腐食物，心胸燠热，小便短赤，肛门热，下利黄臭粪水，口渴引饮，脉沉数或弦数者，此方主之。"@zh ;
    sp:preparation "阴阳水煎，冷服。如转筋者，加鲜勒人藤一两。（《曹炳章医学论文集》）"@zh ;
    sp:source_work "曹炳章医学论文集"@zh ;
    sp:n_mentions 1 .

res:Formula_690292bf95 a sp:Formula ;
    rdfs:label "柴胡白虎煎"@zh ;
    sp:addHerbIf res:Herb_0fa42b86e4 ;
