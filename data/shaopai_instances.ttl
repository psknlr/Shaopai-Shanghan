    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00952"@zh ;
    sp:sourceSentence "《素问》所论运气，当时《六元正纪大论》原文久佚，故晋皇甫谧作《甲乙经》，隋全元起注《素问》，皆云亡失；唐王冰私采阴阳大论七篇补之，诡云秘藏旧本……其说甚辩"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_1ca0c6deb5 ;
    rdf:predicate sp:proposes ;
