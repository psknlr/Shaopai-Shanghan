[] a rdf:Statement ;
    rdf:object res:Work_9921f3307c ;
    rdf:predicate sp:statedIn ;
    rdf:subject res:Doctrine_ed196ddeaa ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 俞根初 / 学术观点及诊治经验 / 传变要诀是“三化”"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00586"@zh ;
    sp:sourceSentence "就予所验，凡太阳伤寒，其邪有但传少阳阳明而止者;有不传少阳阳明越传三阴者，各随其人之体质阴阳，脏腑寒热。从火化者为热证，从水化者为寒证，从水火合化者，则为寒热错杂之证。医者能审其阴阳盛衰、寒热虚实，为之温凉补泻于其间，对证发药，随机应变，心灵手敏，庶可以治伤寒变证矣。”（《大伤寒》）"@zh .

