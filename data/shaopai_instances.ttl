res:Doctrine_9240701044 a sp:Doctrine ;
    rdfs:label "凡温邪初感，发热而微恶寒者，邪在卫分；不恶寒而恶热，小便色黄，已入气分矣；若脉数舌绛，邪入营分；若舌深绛，烦扰不寐，或夜"@zh ;
    sp:proposed_by "章虚谷"@zh ;
    sp:statement_zh "凡温邪初感，发热而微恶寒者，邪在卫分；不恶寒而恶热，小便色黄，已入气分矣；若脉数舌绛，邪入营分；若舌深绛，烦扰不寐，或夜有谵语，已入血分矣"@zh ;
    sp:topic "卫气营血传变"@zh ;
    sp:n_mentions 1 .

