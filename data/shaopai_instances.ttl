res:Doctrine_ef5923c7fb a sp:Doctrine ;
    rdfs:label "然热陷血室之证，多有谵语如狂之象，与阳明胃实相似，此种病机，最须辨别。血结者，身体必重，非若阳明之轻转便捷。盖阴主重浊，"@zh ;
    sp:proposed_by "叶天士"@zh ;
    sp:statement_zh "然热陷血室之证，多有谵语如狂之象，与阳明胃实相似，此种病机，最须辨别。血结者，身体必重，非若阳明之轻转便捷。盖阴主重浊，络脉被阻，身之侧傍气痹，连及胸背，皆拘束不遂，故去邪通络，正合其治"@zh ;
    sp:topic "热陷血室与阳明胃实之辨别"@zh ;
    sp:n_mentions 1 .

