    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "亦有经未至期，因热盛蒸迫血室，则血亦下行。顺则热随血泄，经行后热反化轻。否则热甚冲入胞门，阻拒其行经，下泄之血，留蓄胞门为瘀，以致血室之热，无从得泄，病必增剧。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_c119a80953 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 学术观点与诊治经验 / 防治并举，长于透痧宽喉"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "喉痧由疫毒内伏，其将发之先必五内烦躁，手掌心热，憎寒发热，烦闷口渴，渐渐咽痛。有痧者，热势必壮，用红纸裹细草纸，撚成纸卷，蘸香油燃着，用手逼住火光，照看头面颈项，见有痧点隐隐及周身肤腠通红者，无论晒痧红肿腐烂与否，但觉咽痛，均属喉痧，此初候之病状也"@zh .

