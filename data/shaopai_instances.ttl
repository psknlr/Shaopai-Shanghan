res:Doctrine_1ace54ff8c a sp:Doctrine ;
    rdfs:label "若相火衰弱，中焦虚寒，不能化气，则胃中汤饮痰涎，浊阴凝聚。而衰弱之火，势必不能炎上，而屈伏于下，水道不畅，小便反变黄赤。"@zh ;
    sp:proposed_by "章虚谷"@zh ;
    sp:statement_zh "若相火衰弱，中焦虚寒，不能化气，则胃中汤饮痰涎，浊阴凝聚。而衰弱之火，势必不能炎上，而屈伏于下，水道不畅，小便反变黄赤。此所以中气不足，溲便为变也"@zh ;
    sp:topic "中焦虚寒致小便黄赤病机"@zh ;
    sp:n_mentions 1 .

