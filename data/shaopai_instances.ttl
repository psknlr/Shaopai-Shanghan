res:Doctrine_47ed2a5857 a sp:Doctrine ;
    rdfs:label "每五日为一候，非若伤寒温邪之七日为期也。如第九日有凉汗，则第十日热解，第十四日有凉汗，则第十五日解，如无凉汗，又须一候矣"@zh ;
    sp:proposed_by "何氏"@zh ;
    sp:statement_zh "每五日为一候，非若伤寒温邪之七日为期也。如第九日有凉汗，则第十日热解，第十四日有凉汗，则第十五日解，如无凉汗，又须一候矣。以热解之先一日，必有凉汗，此余所历验不爽者也"@zh ;
    sp:topic "伏暑解期"@zh ;
    sp:n_mentions 1 .

