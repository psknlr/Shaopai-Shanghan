res:Doctrine_000cf5b72b a sp:Doctrine ;
    rdfs:label "凡滑者宜固，结者宜逐"@zh ;
    sp:statedIn res:Work_8886ccc2d8 ;
    sp:proposed_by "赵晴初"@zh ;
    sp:topic "败精治疗原则"@zh ;
    sp:n_mentions 1 .

res:Doctrine_000d1610d6 a sp:Doctrine ;
    rdfs:label "愈后养肝胃之阴，继滋肝肾之阴为要"@zh ;
    sp:proposed_by "赵晴初"@zh ;
    sp:topic "斑的调理"@zh ;
    sp:n_mentions 1 .

res:Doctrine_00425f6f29 a sp:Doctrine ;
    rdfs:label "此投柴胡，为景岳《新方八略》之\"散略\"，散其表证也"@zh ;
    sp:proposed_by "张景岳"@zh ;
    sp:statement_zh "此投柴胡，为景岳《新方八略》之\"散略\"，散其表证也"@zh ;
    sp:topic "散略·柴胡"@zh ;
    sp:n_mentions 1 .

res:Doctrine_006211534a a sp:Doctrine ;
    rdfs:label "夏季为一岁中疾病之生死关，夏季之病较别季为独多"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:topic "夏季养生"@zh ;
    sp:n_mentions 1 .

res:Doctrine_007303123f a sp:Doctrine ;
    rdfs:label "治内伤必先祝由，详告以病之由来，使病人知之，而不敢再犯"@zh ;
    sp:statedIn res:Work_b9a2ec6f87 ;
    sp:proposed_by "吴鞠通"@zh ;
    sp:statement_zh "治内伤必先祝由，详告以病之由来，使病人知之，而不敢再犯"@zh ;
    sp:topic "祝由治法"@zh ;
    sp:n_mentions 1 .

res:Doctrine_007f28e834 a sp:Doctrine ;
    rdfs:label "在气分脉右实大，乌药顺气散，下回生丹治之"@zh ;
    sp:proposed_by "赵晴初"@zh ;
    sp:topic "气分病治疗"@zh ;
    sp:n_mentions 1 .

res:Doctrine_009b1d3258 a sp:Doctrine ;
    rdfs:label "合辟之权，不在乎能放能收，而在乎所以主之者"@zh ;
    sp:proposed_by "张景岳"@zh ;
    sp:statement_zh "合辟之权，不在乎能放能收，而在乎所以主之者"@zh ;
    sp:topic "战汗"@zh ;
    sp:n_mentions 1 .

res:Doctrine_00dbaa2ef3 a sp:Doctrine ;
    rdfs:label "中焦主脘中、大腹，半夏、陈皮是疏畅脘中主药;川朴、腹皮是疏畅大腹主药。"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "中焦主脘中、大腹，半夏、陈皮是疏畅脘中主药;川朴、腹皮是疏畅大腹主药。"@zh ;
    sp:topic "三焦用药法"@zh ;
    sp:n_mentions 1 .

res:Doctrine_014f2d9a25 a sp:Doctrine ;
    rdfs:label "生死之决于脉者，前贤垂询明且备矣。然验之于舌，则尤显而易见也。"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "生死之决于脉者，前贤垂询明且备矣。然验之于舌，则尤显而易见也。"@zh ;
    sp:topic "以色脉相合决生死"@zh ;
    sp:n_mentions 1 .

res:Doctrine_01946d8243 a sp:Doctrine ;
    rdfs:label "方书日富，则圣道日晦"@zh ;
    sp:statedIn res:Work_f7e85fccdc ;
    sp:proposed_by "章氏"@zh ;
    sp:statement_zh "方书日富，则圣道日晦"@zh ;
    sp:topic "医道"@zh ;
