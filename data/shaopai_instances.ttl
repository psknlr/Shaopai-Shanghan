res:Doctrine_9b575cdc4e a sp:Doctrine ;
    rdfs:label "虚者，虚其心，则神自清；无者，无其欲，则精自固。天真之气，从之生长，而精神固守于内，何病之有？"@zh ;
    sp:proposed_by "章虚谷"@zh ;
    sp:statement_zh "虚者，虚其心，则神自清；无者，无其欲，则精自固。天真之气，从之生长，而精神固守于内，何病之有？"@zh ;
    sp:topic "精神内守"@zh ;
    sp:n_mentions 1 .

res:Doctrine_9b6495c419 a sp:Doctrine ;
    rdfs:label "伏邪重者，苔亦厚而且满，板贴不松，脉息数滞不调;症必神烦口渴，渴不引饮，甚则耳聋干呕，面色红黄黑混，口气秽浊。"@zh ;
    sp:proposed_by "何廉臣"@zh ;
    sp:statement_zh "伏邪重者，苔亦厚而且满，板贴不松，脉息数滞不调;症必神烦口渴，渴不引饮，甚则耳聋干呕，面色红黄黑混，口气秽浊。"@zh ;
    sp:topic "伏邪重者脉症"@zh ;
    sp:n_mentions 1 .

