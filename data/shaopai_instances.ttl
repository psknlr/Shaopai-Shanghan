res:Formula_2b89350636 a sp:Formula ;
    rdfs:label "柴苓饮"@zh ;
    sp:derivesFrom res:Work_1e67ecee5d ;
    sp:hasIngredient res:Herb_291656cf2d,
        res:Herb_2dd2a1bd0c,
        res:Herb_c4d816fd56,
        res:Herb_f5b0edf96a ;
    sp:attributed_to "张景岳"@zh ;
    sp:preparation "水一盅半，煎服。如寒邪胜者，加生姜三、五片；如汗出热不退者，加芍药一、二钱。（《景岳全书·新方八阵散阵》）"@zh ;
    sp:source_work "景岳全书·新方八阵散阵"@zh ;
    sp:n_mentions 1 .

res:Formula_3ad3102b16 a sp:Formula ;
    rdfs:label "一柴胡饮"@zh ;
    sp:addHerbIf res:Herb_381ac8de06,
        res:Herb_83ec022527,
        res:Herb_ad0fbd0ae2 ;
    sp:derivesFrom res:Work_1e67ecee5d ;
    sp:hasIngredient res:Herb_25a3db9c69,
        res:Herb_9c2c2c6d0c,
        res:Herb_c2d1278e89,
        res:Herb_c4a3394f04,
        res:Herb_cef3b4132a ;
    sp:removeHerbIf res:Herb_9c2c2c6d0c ;
    sp:attributed_to "张景岳"@zh ;
    sp:preparation "水一盅半，煎七八分，温服。如内热甚者，加连翘一、二钱随宜；如外邪甚者，加防风一钱佐之；如邪结在胸而痞满者，去生地，加枳实一、二钱；如热在阳明而兼渴者，加天花粉或葛根一、二钱；热甚者，加知母、石膏亦可。（《景岳全书·新方八阵散阵》）"@zh ;
    sp:source_work "景岳全书·新方八阵散阵"@zh ;
    sp:n_mentions 1 .

res:Formula_43771c60e3 a sp:Formula ;
    rdfs:label "六味回阳饮"@zh ;
    sp:addHerbIf res:Herb_25a3db9c69,
        res:Herb_2d9de9e26e,
        res:Herb_c4d816fd56 ;
    sp:derivesFrom res:Work_1e67ecee5d ;
    sp:hasIngredient res:Herb_4fffdb45e8,
        res:Herb_c9bcf97acb,
        res:Herb_d0eca59006 ;
    sp:attributed_to "张景岳"@zh ;
    sp:preparation "水二盅，武火煎七八分，温服。如肉振汗多者，加炙黄芪四、五钱或一两，或冬白术三、五钱：如泄泻者，加乌梅二枚，或北五味二十粒亦可；如虚阳上浮者，加茯苓二钱；如肝经郁滞者，加肉桂二、三钱。（《景岳全书·新方八阵热阵》）"@zh ;
    sp:source_work "景岳全书·新方八阵热阵"@zh ;
    sp:n_mentions 1 .

