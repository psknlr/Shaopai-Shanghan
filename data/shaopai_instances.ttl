res:Doctrine_47be302d93 a sp:Doctrine ;
    rdfs:label "病属虚者，其舌必浮胖而娇嫩。实热之证，全舌必有黄黑积滞干焦罅裂芒刺等苔。阴虚之证，全舌必绛色无苔，虽有横直罅纹，而舌则短"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "病属虚者，其舌必浮胖而娇嫩。实热之证，全舌必有黄黑积滞干焦罅裂芒刺等苔。阴虚之证，全舌必绛色无苔，虽有横直罅纹，而舌则短小不等。"@zh ;
    sp:topic "以舌体老嫩晓虚实"@zh ;
    sp:n_mentions 1 .

