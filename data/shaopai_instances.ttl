[] a rdf:Statement ;
    rdf:object res:Doctrine_1b4652025c ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_175513da37 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 学术观点及诊治经验 / 正气为本，邪正虚实乃辨病首务"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "若更兼体丰肌厚，脉盛皮粗，食啖倍多，此阴阳俱盛之质。平时少病，每病多重，以邪蓄深久故也。须用重药，如大黄、芒硝、干姜、桂、附之类。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_1cf37fdf18 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_175513da37 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 学术观点及诊治经验 / 正气为本，邪正虚实乃辨病首务"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "若更兼形瘦脉弱，食饮不多，此阴阳两弱之质。倘目有精彩，耳轮肉厚端正，其先天尚强，神清智朗者，反为大贵。若目无彩，神气昏庸，必多贫夭。凡阴阳俱弱之质，常多病，却不甚重，亦不能受大补大泻大寒大热之药。但宜和平之味，缓缓调之，此大略也。"@zh .

