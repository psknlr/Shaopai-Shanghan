    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00820"@zh ;
    sp:sourceSentence "章氏学医的目的是“尽吾心力”，他把学医比作是以竹筏济人。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_7bcf6ec626 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_175513da37 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 学术观点及诊治经验 / 正气为本，邪正虚实乃辨病首务"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00849"@zh ;
    sp:sourceSentence "若论其变，则有阳旺阴弱之人，而损伤阳气者，宜先扶阳，而后滋阴；阴盛阳虚之人，而有伤阴者，宜先滋阴，而后助阳。斯当随时审察，不可拘执。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_829dde09f0 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_175513da37 ;
    sp:agreement "single_engine"@zh ;
