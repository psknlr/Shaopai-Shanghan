    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "伤食者饮食自倍，肠胃乃伤，病在不及消化；停食指不论食之多少，或当食而怒，或当食时病在气结而不能化。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_85380190a4 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_b5cb5b9c75 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 俞根初 / 生平与代表著作简介"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "勘伤寒症，全凭胆识。望形察色，辨舌诊脉，在乎识；选药制方，定量减味，在乎胆。必先有定识于平时，乃能有定见于俄顷。然临证断病，必须眼到、手到、心到，三者俱到，活泼泼地，而治病始能无误，熟能生巧，非笨伯所能模仿也"@zh .

