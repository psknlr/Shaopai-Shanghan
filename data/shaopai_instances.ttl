res:Doctrine_6ea23ca407 a sp:Doctrine ;
    rdfs:label "其发于春者曰春温，或曰春时晚发。发于夏者曰夏温，或曰热病。发于秋者曰秋温，或曰秋时晚发，或曰伏暑。发于冬者曰冬温，或曰伏"@zh ;
    sp:proposed_by "何廉臣"@zh ;
    sp:statement_zh "其发于春者曰春温，或曰春时晚发。发于夏者曰夏温，或曰热病。发于秋者曰秋温，或曰秋时晚发，或曰伏暑。发于冬者曰冬温，或曰伏暑冬发"@zh ;
    sp:topic "以时令别其病名"@zh ;
    sp:n_mentions 1 .

