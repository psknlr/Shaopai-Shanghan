res:Doctrine_913e481f91 a sp:Doctrine ;
    rdfs:label "本门最详者脉也，脉为气血流行之象，而有升降出入，故当与营卫经络、阴阳脏腑诸门同观。必得悟其神理，指下方能明其为和、为病、"@zh ;
    sp:proposed_by "章虚谷"@zh ;
    sp:statement_zh "本门最详者脉也，脉为气血流行之象，而有升降出入，故当与营卫经络、阴阳脏腑诸门同观。必得悟其神理，指下方能明其为和、为病、为虚、为实。"@zh ;
    sp:topic "脉诊"@zh ;
    sp:n_mentions 1 .

