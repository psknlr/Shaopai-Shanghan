res:Doctrine_10779b5c1d a sp:Doctrine ;
    rdfs:label "治法以蚕沙、滑石、蒌皮、郁金化滞宣气开郁，鲜生地捣豆豉、青蒿、白薇、焦栀以清透营热从外达。湿化热透，大便自下，小溲亦长。"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "治法以蚕沙、滑石、蒌皮、郁金化滞宣气开郁，鲜生地捣豆豉、青蒿、白薇、焦栀以清透营热从外达。湿化热透，大便自下，小溲亦长。若误用羌、防、枳、朴则化燥，反加胸闷干呕。若用硝、黄妄下，则下利稀水，口舌化燥，胸闷干呕，热亦增剧，脾胃浊垢，因化燥而不下"@zh ;
    sp:topic "伏暑湿遏热伏证治"@zh ;
    sp:n_mentions 1 .

