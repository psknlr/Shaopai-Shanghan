res:Doctrine_7bcf6ec626 a sp:Doctrine ;
    rdfs:label "阳旺阴弱之人而损伤阳气者，宜先扶阳，而后滋阴；阴盛阳虚之人而有伤阴者，宜先滋阴，而后助阳，斯当随时审察，不可拘执"@zh ;
    sp:proposed_by "章氏"@zh ;
    sp:statement_zh "阳旺阴弱之人而损伤阳气者，宜先扶阳，而后滋阴；阴盛阳虚之人而有伤阴者，宜先滋阴，而后助阳，斯当随时审察，不可拘执"@zh ;
    sp:topic "治则变通"@zh ;
    sp:n_mentions 1 .

