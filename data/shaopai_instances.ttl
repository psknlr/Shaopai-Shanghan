res:Doctrine_0f13a0ec51 a sp:Doctrine ;
    rdfs:label "体丰色白，皮嫩肌松，脉大而软，食啖虽多，每生痰涎，此阴盛阳虚之质。每病虽热邪，药不可过寒，更伤其阳，阳微则防其脱。热退须"@zh ;
    sp:proposed_by "章虚谷"@zh ;
    sp:statement_zh "体丰色白，皮嫩肌松，脉大而软，食啖虽多，每生痰涎，此阴盛阳虚之质。每病虽热邪，药不可过寒，更伤其阳，阳微则防其脱。热退须用温补扶阳。"@zh ;
    sp:topic "阴盛阳虚之质"@zh ;
    sp:n_mentions 1 .

res:Doctrine_0f7af5d514 a sp:Doctrine ;
