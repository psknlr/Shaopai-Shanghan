res:Doctrine_4249d74d83 a sp:Doctrine ;
    rdfs:label "如邪在血脉失治，则渐入包络，此为由浅人深；若邪在包络而治之得法，则渐归血脉，此为由深出浅；若邪盛势锐，不从气分转入，不由"@zh ;
    sp:proposed_by "赵晴初"@zh ;
    sp:statement_zh "如邪在血脉失治，则渐入包络，此为由浅人深；若邪在包络而治之得法，则渐归血脉，此为由深出浅；若邪盛势锐，不从气分转入，不由血脉渐入，而直入心包，其证最为凶险"@zh ;
