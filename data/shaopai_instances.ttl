    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "今凡深奥简古之文，悉心体会，详细辨注，必明其不易之理；其有文义明晰易解，毋须赘注者，则略之。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_c2072ba5f2 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_175513da37 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 学术观点及诊治经验 / 正气为本，邪正虚实乃辨病首务"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "如体丰色白，皮嫩肌松，脉大而软，食啖虽多，每生痰涎，此阴盛阳虚之质。目有精彩，尚可无妨，如无精彩，寿多不永，或未到中年，而得中风之病。每病虽热邪，药不可过寒，更伤其阳，阳微则防其脱，热退须用温补扶阳。"@zh .

