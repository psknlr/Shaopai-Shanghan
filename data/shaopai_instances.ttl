res:Doctrine_0d67497eb2 a sp:Doctrine ;
    rdfs:label "顺则可治，逆则难医，如夏月人病黑苔，是时气与邪火，内外炎烁，尚有可生。如冬月黑苔厚刺，正不胜邪，必难救治也。"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "顺则可治，逆则难医，如夏月人病黑苔，是时气与邪火，内外炎烁，尚有可生。如冬月黑苔厚刺，正不胜邪，必难救治也。"@zh ;
    sp:topic "以合乎节气知顺逆"@zh ;
    sp:n_mentions 1 .

res:Doctrine_0d7a708f07 a sp:Doctrine ;
    rdfs:label "学医犹学奕也，医书犹奕谱也。世之善奕者，未有不专心致志于奕谱，而后始有得心应手之一候。然对局之际，检谱以应敌，则胶柱鼓瑟"@zh ;
    sp:proposed_by "赵晴初"@zh ;
    sp:statement_zh "学医犹学奕也，医书犹奕谱也。世之善奕者，未有不专心致志于奕谱，而后始有得心应手之一候。然对局之际，检谱以应敌，则胶柱鼓瑟，必败之道也。医何独不然？"@zh ;
    sp:topic "反对拘方制药"@zh ;
    sp:n_mentions 1 .

