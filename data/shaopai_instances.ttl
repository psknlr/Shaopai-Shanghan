    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "顺则可治，逆则难医，如夏月人病黑苔，是时气与邪火，内外炎烁，尚有可生。如冬月黑苔厚刺，正不胜邪，必难救治也。"@zh .

