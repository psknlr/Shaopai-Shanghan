res:Doctrine_9798af6393 a sp:Doctrine ;
    rdfs:label "肢节疼痛，病名历节，此证起于风邪外感，汗出不畅，久久湿流关节，脉迟而滑，属寒湿。其微者用桂枝芍药知母汤，其剧者宜乌头汤"@zh ;
    sp:proposed_by "曹颖甫"@zh ;
    sp:statement_zh "肢节疼痛，病名历节，此证起于风邪外感，汗出不畅，久久湿流关节，脉迟而滑，属寒湿。其微者用桂枝芍药知母汤，其剧者宜乌头汤"@zh ;
    sp:topic "历节"@zh ;
    sp:n_mentions 1 .

res:Doctrine_97d7679f88 a sp:Doctrine ;
