[] a rdf:Statement ;
    rdf:object res:Doctrine_72cac1a98a ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_b5cb5b9c75 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 俞根初 / 学术观点及诊治经验 / 崇六经、参三焦，倡外感新论"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00529"@zh ;
    sp:sourceSentence "“阳道实，故风寒实邪从太阳汗之，燥热实邪从阳明下之，邪之微者，从少阳和之；阴道虚，故寒湿虚邪从太阴温之，风热虚邪，从厥阴清之，虚之甚者，从少阴补之；阳道虽实，而少阳为邪之微，故和而兼补；阴道本虚，而少阴尤虚之极，故补之须峻”"@zh .

