res:Doctrine_735a2186bd a sp:Doctrine ;
    rdfs:label "若热邪陷入，与血相结者，当从陶氏小柴胡汤去参、枣，加鲜生地、桃仁、楂肉、丹皮、或犀角等，凉血散血，使血不与热相搏，而后能"@zh ;
    sp:proposed_by "叶天士"@zh ;
    sp:statement_zh "若热邪陷入，与血相结者，当从陶氏小柴胡汤去参、枣，加鲜生地、桃仁、楂肉、丹皮、或犀角等，凉血散血，使血不与热相搏，而后能和解，如陶氏之法也"@zh ;
    sp:topic "热陷血室与血相结之治法"@zh ;
    sp:n_mentions 1 .

