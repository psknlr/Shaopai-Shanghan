res:Doctrine_9d8d5a03c0 a sp:Doctrine ;
    rdfs:label "解表已，复热；攻里热已，复热；利小便愈后，复热；养阴滋清，热亦不除；元气无所归着，保元、归脾以除虚热"@zh ;
    sp:proposed_by "张氏"@zh ;
    sp:statement_zh "解表已，复热；攻里热已，复热；利小便愈后，复热；养阴滋清，热亦不除；元气无所归着，保元、归脾以除虚热"@zh ;
    sp:topic "阳浮倏热"@zh ;
    sp:n_mentions 1 .

