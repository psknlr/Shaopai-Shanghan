    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "实则《内经》是论阴阳偏胜之病，非论阴阳之理，君火相火实即火之体用"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_7d95296538 ;
    rdf:predicate sp:proposes ;
