[] a rdf:Statement ;
    rdf:object res:Herb_9c2c2c6d0c ;
    rdf:predicate sp:removeHerbIf ;
    rdf:subject res:Formula_3ad3102b16 ;
    sp:agreement "deterministic_parse"@zh ;
    sp:chapterPath "第二部分 代表医家 / 张景岳 / 四、方剂选录 / （一）诸柴胡饮"@zh ;
    sp:engine "rule-parser-v1"@zh ;
    sp:evidenceVerbatim true ;
    sp:modificationCondition "邪结在胸而痞满"@zh ;
    sp:nSupport 1 ;
    sp:passageId "b00339"@zh ;
    sp:sourceSentence "水一盅半，煎七八分，温服。如内热甚者，加连翘一、二钱随宜；如外邪甚者，加防风一钱佐之；如邪结在胸而痞满者，去生地，加枳实一、二钱；如热在阳明而兼渴者，加天花粉或葛根一、二钱；热甚者，加知母、石膏亦可。（《景岳全书·新方八阵散阵》）"@zh .

[] a rdf:Statement ;
