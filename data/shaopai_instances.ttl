    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "故俞氏根据温热病致病的特点，在六经辨证大纲指导下，参以六淫、新感伏邪致病说（其中对六淫中湿之为病辨之尤详）"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_896d53daca ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_b5cb5b9c75 ;
    sp:agreement "single_engine"@zh ;
