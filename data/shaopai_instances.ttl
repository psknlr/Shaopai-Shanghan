res:Doctrine_b9e309abf3 a sp:Doctrine ;
    rdfs:label "大病瘥后，食猪肉及羊血肥鱼油腻等，必大下利，难治；食饼、饵、粢、黍、饴、餔、烩、馐，枣、栗、诸果坚实难消之物，胃气虚弱，"@zh ;
    sp:statedIn res:Work_79dc97bce5 ;
    sp:statement_zh "大病瘥后，食猪肉及羊血肥鱼油腻等，必大下利，难治；食饼、饵、粢、黍、饴、餔、烩、馐，枣、栗、诸果坚实难消之物，胃气虚弱，不能消化，必更结热。不下必死，下之复危，皆难治也"@zh ;
    sp:topic "瘥后食复禁忌"@zh ;
    sp:n_mentions 1 .

res:Doctrine_ba63f251ed a sp:Doctrine ;
    rdfs:label "亦有经未至期，因热盛蒸迫血室，则血亦下行。顺则热随血泄，经行后热反化轻。否则热甚冲入胞门，阻拒其行经，下泄之血，留蓄胞门"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "亦有经未至期，因热盛蒸迫血室，则血亦下行。顺则热随血泄，经行后热反化轻。否则热甚冲入胞门，阻拒其行经，下泄之血，留蓄胞门为瘀，以致血室之热，无从得泄，病必增剧"@zh ;
    sp:topic "热入血室之顺逆"@zh ;
    sp:n_mentions 1 .

