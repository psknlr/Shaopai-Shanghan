[] a rdf:Statement ;
    rdf:object res:Doctrine_735a2186bd ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_5f1fdad40e ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 原文选释 / 论临经伤寒"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01802"@zh ;
    sp:sourceSentence "若热邪陷入，与血相结者（较热入血室、不与血相结者为重），当从陶氏小柴胡汤去参、枣，加鲜生地、桃仁、楂肉、丹皮、或犀角等，凉血散血，使血不与热相搏，而后能和解，如陶氏之法也。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_76eaa11818 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_5f1fdad40e ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 曹炳章 / 原文选释 / 论临经伤寒"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01802"@zh ;
    sp:sourceSentence "若本经血结自甚，或挟有瘀伤宿血，挟热而得者，其证必少腹满痛，轻者刺期门，以泄其实，使气行瘀散也。重者小柴胡汤，去参枣之甘药，加延胡索、归尾、桃仁，以利其气，破其血也。挟寒加桂心，气滞加香附、陈皮、枳壳。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_95bd50d2e5 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_5f1fdad40e ;
    sp:agreement "single_engine"@zh ;
