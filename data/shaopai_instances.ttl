res:Doctrine_7c1084f0cd a sp:Doctrine ;
    rdfs:label "体丰肌厚，脉盛皮粗，食啖倍多，此阴阳俱盛之质。平时少病，每病多重，须用重药，如大黄、芒硝、干姜、桂、附之类。"@zh ;
    sp:proposed_by "章虚谷"@zh ;
    sp:statement_zh "体丰肌厚，脉盛皮粗，食啖倍多，此阴阳俱盛之质。平时少病，每病多重，须用重药，如大黄、芒硝、干姜、桂、附之类。"@zh ;
    sp:topic "阴阳俱盛之质"@zh ;
    sp:n_mentions 1 .

res:Doctrine_7c302f2514 a sp:Doctrine ;
    rdfs:label "饮食不洁，或贪食肥甘，喜食水果、生冷等物，席地当风露卧，内停冷食，旬中寒邪，扰乱中宫，腹痛吐泻交作，即为霍乱"@zh ;
    sp:proposed_by "曹炳章"@zh ;
    sp:statement_zh "饮食不洁，或贪食肥甘，喜食水果、生冷等物，席地当风露卧，内停冷食，旬中寒邪，扰乱中宫，腹痛吐泻交作，即为霍乱"@zh ;
    sp:topic "霍乱病因"@zh ;
    sp:n_mentions 1 .

