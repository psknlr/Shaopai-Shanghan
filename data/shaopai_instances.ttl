res:Doctrine_6e1e25600e a sp:Doctrine ;
    rdfs:label "为月事，为养胎，皆血是也，其既产以为乳者，乳非血也。乳者，乃饮食入胃化出之乳糜汁而为乳，实未成血之物也"@zh ;
    sp:proposed_by "曹炳章"@zh ;
