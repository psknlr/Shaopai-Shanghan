    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "邪入之其人，阳旺则热多厥少，阳虚则热少厥多，阳胜则邪外出而愈，阴胜则邪内陷而死"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_19ec3d7afd ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_7577a19b15 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 学术观点及诊治经验 / 正气为本，邪正虚实乃辨病首务"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "若无六气之邪，而病出三阴，则唯情欲以伤内，劳倦以伤外，非邪似邪，非实似实，此所谓无，无则病在元气也。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_1ace54ff8c ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_7577a19b15 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 医案选按 / 胃阳不振胃阴不足疑似案"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "若相火衰弱，中焦虚寒，不能化气，则胃中汤饮痰涎，浊阴凝聚。而衰弱之火，势必不能炎上，而屈伏于下，水道不畅，小便反变黄赤。此所以中气不足，溲便为变也。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_1e94eb9920 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_7577a19b15 ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 章虚谷 / 学术观点及诊治经验 / 大胆创新，承前启后乃新学功臣"@zh ;
    sp:corpus "shaopai"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "“风寒先受于足经，当用辛温发汗；风温先受于手经，宜用辛凉解表。上下部异，寒温不同，故治法大异，此伤寒与温病，其初感与传变，皆不同也。”"@zh .

