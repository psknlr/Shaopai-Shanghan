    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "其断病，若者七日愈，若者十四愈，若者二十一日愈，十有九验"@zh .

