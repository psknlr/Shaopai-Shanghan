    sp:n_mentions 1 .

res:Doctrine_981814e127 a sp:Doctrine ;
    rdfs:label "过期不愈者，凡疫邪交卸，近在一七，远在二七，甚至三七，过此不愈者，因非其治，不为坏症，即为痼疾也"@zh ;
    sp:proposed_by "吴又可"@zh ;
    sp:statement_zh "过期不愈者，凡疫邪交卸，近在一七，远在二七，甚至三七，过此不愈者，因非其治，不为坏症，即为痼疾也"@zh ;
    sp:topic "疫邪交卸时限"@zh ;
