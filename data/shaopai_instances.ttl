[] a rdf:Statement ;
    rdf:object res:Work_e9f8ea6408 ;
    rdf:predicate sp:statedIn ;
    rdf:subject res:Doctrine_8270d0adee ;
    sp:agreement "single_engine"@zh ;
    sp:chapterPath "代表医家 / 赵晴初 / 学术观点及诊治经验 / 外感遵法伤寒，推崇兼容并包"@zh ;
    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01374"@zh ;
    sp:sourceSentence "如对哮喘证的辨证论治，指出此证“大抵有积痰在肺络中，痰碍气，气触痰，是以喉中呼吸有声。……盖肺肾为俯仰之脏，《内经》所谓‘肾上连肺’是也。肺气开张，上而不下，久久震动元海，波及肾矣。肾旺则摄纳有权，不致犯上无等，倘肾复虚惫，则其害更非浅显”(《医案偶存》)"@zh .

