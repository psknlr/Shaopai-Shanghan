    sp:layer "lineage"@zh ;
    sp:nSupport 2 ;
    sp:sourceSentence "俞氏在辨证上提出“以六经钤百病，为确定之总诀；以三焦赅疫证，为变通之捷诀”（《六经总诀》）"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_2dfa93a497 ;
    rdf:predicate sp:proposes ;
