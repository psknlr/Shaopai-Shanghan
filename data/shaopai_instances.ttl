res:Doctrine_b10a5a3504 a sp:Doctrine ;
    rdfs:label "阴阳既明，则表于里对，虚于实对，寒与热对。明此六变，明此阴阳，则天下之病固不能出此八者"@zh ;
    sp:proposed_by "张景岳"@zh ;
