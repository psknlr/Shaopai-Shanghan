    sp:topic "温热病的治疗原则"@zh ;
    sp:n_mentions 1 .

res:Doctrine_72cac1a98a a sp:Doctrine ;
    rdfs:label "阳道实，故风寒实邪从太阳汗之，燥热实邪从阳明下之，邪之微者，从少阳和之；阴道虚，故寒湿虚邪从太阴温之，风热虚邪，从厥阴清"@zh ;
    sp:proposed_by "俞根初"@zh ;
    sp:statement_zh "阳道实，故风寒实邪从太阳汗之，燥热实邪从阳明下之，邪之微者，从少阳和之；阴道虚，故寒湿虚邪从太阴温之，风热虚邪，从厥阴清之，虚之甚者，从少阴补之；阳道虽实，而少阳为邪之微，故和而兼补；阴道本虚，而少阴尤虚之极，故补之须峻"@zh ;
    sp:topic "六经治法"@zh ;
    sp:n_mentions 1 .

res:Doctrine_72e2d43307 a sp:Doctrine ;
