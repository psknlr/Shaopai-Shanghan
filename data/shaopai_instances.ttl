        res:Herb_cff02fc619,
        res:Herb_ffa0cb142b ;
    sp:attributed_to "曹炳章"@zh ;
    sp:indication "治霍乱舌白，胸中泛泛，周身不畅，欲吐不吐，欲泻不泻，承其尚末吐泻，即服此方。使重者转轻，轻者即愈。"@zh ;
    sp:preparation "阴阳水煎，微冷服。（《曹炳章医学论文集》）"@zh ;
    sp:source_work "曹炳章医学论文集"@zh ;
    sp:n_mentions 1 .

