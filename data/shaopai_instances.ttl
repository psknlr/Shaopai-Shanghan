    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p00852"@zh ;
    sp:sourceSentence "章氏释之曰：“胃为戊土属阳，脾为己土属阴，湿土之气，同类相召，故湿热之邪，始虽外受，终归脾胃也。”"@zh .

[] a rdf:Statement ;
