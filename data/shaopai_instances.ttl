res:Doctrine_7b82a05445 a sp:Doctrine ;
    rdfs:label "气短，呼吸短促而不相接续，与呼吸微弱不同而又相同。徐氏认为，气微的呼吸是静而无声的，气短是躁而带粗的；气微状态则自然，气"@zh ;
    sp:proposed_by "徐荣斋"@zh ;
    sp:statement_zh "气短，呼吸短促而不相接续，与呼吸微弱不同而又相同。徐氏认为，气微的呼吸是静而无声的，气短是躁而带粗的；气微状态则自然，气短状态很勉强。并指出，气微者，在病机上只虚无实，多属外感病末传；气短者，在病机上有虚有实，多属内伤病初起。气微为病退之时，气短为病进之候。"@zh ;
    sp:topic "气短"@zh ;
    sp:n_mentions 1 .

res:Doctrine_7b9ec0a6d4 a sp:Doctrine ;
