    sp:layer "lineage"@zh ;
    sp:nSupport 1 ;
    sp:sourceSentence "从假托乱真之去伪、名物传讹之考正、仿造伪品之革除、埋没良材之推行、不精修治之改良、采取贮藏之合法六个部分论述药品改良之方法。"@zh .

[] a rdf:Statement ;
    rdf:object res:Doctrine_47be302d93 ;
    rdf:predicate sp:proposes ;
    rdf:subject res:Physician_bec16b53a7 ;
    sp:agreement "single_engine"@zh ;
