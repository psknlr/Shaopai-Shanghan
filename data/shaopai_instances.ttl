    sp:engine "builtin-sonnet"@zh ;
    sp:evidenceVerbatim true ;
    sp:nSupport 1 ;
    sp:passageId "p01024"@zh ;
    sp:sourceSentence "其除气分之湿，用蔻仁、滑石、杏仁、川朴、姜半夏、瓜蒌皮为主，有热加竹叶、连翘、芦根等，全取轻清之品，走气道以除湿"@zh .

