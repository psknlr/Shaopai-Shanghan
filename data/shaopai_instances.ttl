res:Doctrine_a5e828585d a sp:Doctrine ;
    rdfs:label "方以生玉竹滋阴润燥为君，臣以葱、豉、薄、桔，疏风散热。佐以白薇苦咸降泄。使以甘草、红枣，甘润增液，以助玉竹之滋阴润燥。为"@zh ;
    sp:statement_zh "方以生玉竹滋阴润燥为君，臣以葱、豉、薄、桔，疏风散热。佐以白薇苦咸降泄。使以甘草、红枣，甘润增液，以助玉竹之滋阴润燥。为阴虚体感冒风温，及冬温咳嗽、咽干痰结之良剂。"@zh ;
    sp:topic "加减葳蕤汤方义"@zh ;
    sp:n_mentions 1 .

res:Doctrine_a5eaa0f5a7 a sp:Doctrine ;
    rdfs:label "上焦宜宣，开肺气，疏腠理，甚则开窍，均属宣之范畴。中焦宜运，燥湿，化湿，开膈，快脾，均可归纳于运字之中。下焦宜导，渗湿，"@zh ;
    sp:proposed_by "胡宝书"@zh ;
    sp:statement_zh "上焦宜宣，开肺气，疏腠理，甚则开窍，均属宣之范畴。中焦宜运，燥湿，化湿，开膈，快脾，均可归纳于运字之中。下焦宜导，渗湿，导湿，旨在分利小便，即古人‘治湿不利小便，非其治也’之义。"@zh ;
    sp:topic "宣运导三法"@zh ;
    sp:n_mentions 1 .

