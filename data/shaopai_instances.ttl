res:Doctrine_0896bcb38a a sp:Doctrine ;
    rdfs:label "气喘，为气急之总称，有虚实之分。呼吸气粗，声高息涌，但以呼出为快，属实喘；声低息短，吸气困难，张口抬肩，属虚喘。一般来说"@zh ;
    sp:statement_zh "气喘，为气急之总称，有虚实之分。呼吸气粗，声高息涌，但以呼出为快，属实喘；声低息短，吸气困难，张口抬肩，属虚喘。一般来说实喘易治，虚喘难疗。"@zh ;
    sp:topic "气喘"@zh ;
    sp:n_mentions 1 .

